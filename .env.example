# Copy to .env.local for local dev. On Vercel: Project Settings → Environment Variables.
# MongoDB Atlas connection string (get it from Atlas → Connect → Drivers → Node.js).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name used for native profiles.
MONGODB_DB=kundali
# Auth: random 32+ char secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Public site URL (production: https://<your-app>.vercel.app). Needed for login callbacks.
NEXTAUTH_URL=http://localhost:3002
# Optional: Google login. Create OAuth client at console.cloud.google.com → Credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
